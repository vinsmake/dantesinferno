---
import DoreBase from '../layouts/DoreBase.astro';
import Defs from '../components/Defs.astro';
import Hud from '../components/Hud.astro';
import Pin from '../components/dore/Pin.astro';
import Scene from '../components/dore/Scene.astro';
import Notes from '../components/dore/Notes.astro';
import Plate from '../components/dore/Plate.astro';
import Bolge from '../components/dore/Bolge.astro';

---
<DoreBase title="Inferno · Grabados de Gustave Doré" description="Un descenso por el Infierno de Dante a través de los grabados de Gustave Doré (1861).">
  <Defs />
  <div id="atmo" aria-hidden="true"></div>
  <canvas id="fx" aria-hidden="true"></canvas>
  <div id="vignette" aria-hidden="true"></div>
  <div id="hatch" aria-hidden="true"></div>
  <div id="grain" aria-hidden="true"></div>
  <Hud />

  <main>
    <!-- Canto I: the dark wood, the beasts, Virgil -->
    <Pin
      id="selva" mode="motes" bg="#0b0a08" glow="#26221a" level={-1} label="La selva oscura" len="420%" fx={['rays', 'fog']}
      steps={[
        { img: 'selva', x: 0.5, y: 0.55, s: 1.0 },
        { img: 'selva', x: 0.55, y: 0.66, s: 1.9, it: 'Nel mezzo del cammin di nostra vita<br/>mi ritrovai per una selva oscura,<br/>ché la diritta via era smarrita.', tr: 'A mitad del camino de nuestra vida me encontré en una selva oscura, pues la recta vía había perdido.', cite: 'Inferno I, 1–3' },
        { img: 'leone', x: 0.55, y: 0.45, s: 1.1, it: 'questi parea che contra me venisse<br/>con la test\'alta e con rabbiosa fame', tr: 'Parecía que venía contra mí, con la cabeza alta y con rabiosa hambre.', cite: 'Inferno I, 46–47' },
        { img: 'leone', x: 0.7, y: 0.6, s: 2.0 },
        { img: 'virgilio', x: 0.36, y: 0.6, s: 1.7, it: '«Or se\' tu quel Virgilio e quella fonte<br/>che spandi di parlar sì largo fiume?»', tr: '¿Eres tú aquel Virgilio, aquella fuente que derrama tan ancho río de palabras?', cite: 'Inferno I, 79–80' },
      ]}
    >
      <div class="hero-title">
        <p class="pre">Dante Alighieri · Gustave Doré</p>
        <h1 aria-label="Inferno">{'INFERNO'.split('').map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</h1>
        <p class="by">Un descenso en grabados<i>Ilustraciones de la edición de 1861</i></p>
      </div>
      <div class="scroll-cue"><span>Desciende</span><i></i></div>
    </Pin>

    <!-- Canto III: the gate -->
    <Pin
      id="puerta" mode="ash" bg="#0b0a09" glow="#2a2419" level={0} label="La Puerta" len="300%" kicker="Canto III" title="La Puerta" fx={['fog']}
      steps={[
        { img: 'puerta', x: 0.5, y: 0.35, s: 1.05 },
        { img: 'puerta', x: 0.56, y: 0.62, s: 2.4, it: 'Per me si va ne la città dolente,<br/>per me si va ne l\'etterno dolore,<br/>per me si va tra la perduta gente.', tr: 'Por mí se va a la ciudad doliente, por mí se va al eterno dolor, por mí se va con la gente perdida.', cite: 'Inferno III, 1–3' },
        { img: 'puerta', x: 0.45, y: 0.5, s: 1.25, it: 'Lasciate ogne speranza, voi ch\'intrate.', tr: 'Abandonad toda esperanza, vosotros que entráis.', cite: 'Inferno III, 9' },
      ]}
    />

    <Scene
      id="ignavi" mode="flies" bg="#0a0908" glow="#1f1b14" level={0} label="Vestíbulo" layout="wide"
      kicker="Vestíbulo · Canto III" title="Los Ignavos" sin="Los tibios, que nunca eligieron bando"
      plate={{ img: 'ignavi', alt: 'Las almas se agolpan en la orilla del Aqueronte, grabado de Doré', caption: 'Caron dimonio... batte col remo qualunque s\'adagia', cite: 'Inferno III, 109–111', fx: ['fog'] }}
      verse={["che visser sanza 'nfamia e sanza lodo"]} cite="Inferno III, 36" translation="que vivieron sin infamia y sin alabanza"
      punishment="Corren desnudos tras una bandera que gira sin sentido, picados por tábanos y avispas. Ni el Cielo ni el Infierno los quieren. Más allá, en la triste orilla del Aqueronte, las almas se apiñan como hojas que caen en otoño, esperando la barca."
      figures={['Celestino V, «el de la gran renuncia»', 'Los ángeles neutrales']}
    />

    <Pin
      id="aqueronte" mode="leaves" bg="#08090a" glow="#1b1d1f" level={0} label="Aqueronte" len="300%" kicker="Canto III · La frontera" title="Caronte" anim="breathe" fx={['fog']}
      steps={[
        { img: 'caronte', x: 0.5, y: 0.3, s: 1.0 },
        { img: 'caronte', x: 0.62, y: 0.38, s: 2.6, it: 'Caron dimonio, con occhi di bragia,<br/>loro accennando, tutte le raccoglie', tr: 'Caronte, demonio de ojos de brasa, haciéndoles señas, a todas las recoge.', cite: 'Inferno III, 109–110' },
        { img: 'caronte', x: 0.45, y: 0.82, s: 1.5, it: 'batte col remo qualunque s\'adagia', tr: 'golpea con el remo a quien se demora.', cite: 'Inferno III, 111' },
      ]}
    />

    <Scene
      id="limbo" mode="motes" bg="#0b0b09" glow="#2a271d" level={1} label="I · Limbo" num="I" layout="left"
      kicker="Círculo I · Canto IV" title="Limbo" sin="Los virtuosos sin bautismo"
      plate={{ img: 'limbo', alt: 'Homero y los poetas clásicos reciben a Dante en el Limbo, grabado de Doré', caption: 'Mira colui con quella spada in mano', cite: 'Inferno IV, 86', fx: ['rays'] }}
      verse={['sanza speme vivemo in disio']} cite="Inferno IV, 42" translation="sin esperanza vivimos en deseo"
      punishment="No hay tormento, sólo suspiros que hacen temblar el aire eterno. En un noble castillo de siete murallas, bajo una cúpula de luz, esperan los grandes espíritus de la Antigüedad. Homero avanza con la espada en la mano y acoge a Dante como sexto entre los poetas."
      guardian="Ninguno. Aquí vive el propio Virgilio."
      figures={['Homero', 'Horacio', 'Ovidio', 'Lucano', 'Sócrates', 'Platón', 'Aristóteles', 'Saladino']}
    />

    <!-- Canto V -->
    <Pin
      id="lujuria" mode="wind" bg="#0a0909" glow="#221e1c" level={2} label="II · Lujuria" len="420%" kicker="Círculo II · Canto V" title="Lujuria" fx={['storm']}
      steps={[
        { img: 'minos', x: 0.6, y: 0.45, s: 1.0 },
        { img: 'minos', x: 0.8, y: 0.3, s: 2.2, it: 'Stavvi Minòs orribilmente, e ringhia:<br/>essamina le colpe ne l\'intrata', tr: 'Allí está Minos, horrible, y gruñe: examina las culpas a la entrada.', cite: 'Inferno V, 4–5' },
        { img: 'lujuria', x: 0.55, y: 0.4, s: 1.05, it: 'La bufera infernal, che mai non resta,<br/>mena li spirti con la sua rapina', tr: 'La borrasca infernal, que nunca cesa, arrastra a los espíritus con su violencia.', cite: 'Inferno V, 31–32' },
        { img: 'lujuria', x: 0.62, y: 0.35, s: 2.2 },
        { img: 'francesca', x: 0.5, y: 0.35, s: 1.4, it: 'Amor, ch\'a nullo amato amar perdona,<br/>mi prese del costui piacer sì forte', tr: 'Amor, que a ningún amado amar perdona, me prendió del placer de éste tan fuerte...', cite: 'Inferno V, 103–104' },
      ]}
    />
    <Notes
      id="lujuria-notas" mode="wind" bg="#0a0909" glow="#221e1c" level={2} label="II · Lujuria"
      punishment="Un torbellino eterno los arrastra como bandadas de estorninos en invierno, golpeándolos sin descanso: así como en vida se dejaron llevar por la pasión. Al oír a Francesca, Dante cae desmayado de piedad, «come corpo morto cade»."
      guardian="Minos, el juez. Escucha cada confesión y enrosca su cola tantas veces como círculos debe descender el alma."
      figures={['Francesca da Rimini y Paolo', 'Cleopatra', 'Semíramis', 'Dido', 'Helena', 'Aquiles', 'Tristán']}
    />

    <Scene
      id="gula" mode="rain" bg="#090a0a" glow="#1c1f1f" level={3} label="III · Gula" num="III" layout="wide"
      kicker="Círculo III · Canto VI" title="Gula" sin="Los que vivieron para el placer de la mesa"
      plate={{ img: 'cerbero', alt: 'Virgilio arroja tierra a las fauces de Cerbero, grabado de Doré', caption: 'Cerbero, fiera crudele e diversa', cite: 'Inferno VI, 13' }}
      verse={['Io sono al terzo cerchio, de la piova', 'etterna, maladetta, fredda e greve']} cite="Inferno VI, 7–8"
      translation="Estoy en el tercer círculo, el de la lluvia eterna, maldita, fría y pesada"
      punishment="Yacen en un fango hediondo bajo una lluvia perpetua de granizo, agua sucia y nieve, aullando como perros."
      guardian="Cerbero, la fiera de tres gargantas, de ojos bermejos y barba grasienta. Virgilio lo calma arrojándole puñados de tierra a las fauces."
      figures={['Ciacco, el florentino']}
    />

    <Scene
      id="avaricia" mode="dust" bg="#0b0a08" glow="#26201a" level={4} label="IV · Avaricia" num="IV" layout="wide"
      kicker="Círculo IV · Canto VII" title="Avaricia y Prodigalidad" sin="Los que guardaron y los que derrocharon"
      plate={{ img: 'avaricia', alt: 'Avaros y pródigos empujan enormes pesos, grabado de Doré', caption: 'Perché tieni? e Perché burli?', cite: 'Inferno VII, 30' }}
      verse={['«Pape Satàn, pape Satàn aleppe!»', 'cominciò Pluto con la voce chioccia']} cite="Inferno VII, 1–2"
      translation="«¡Pape Satàn, pape Satàn aleppe!», comenzó Pluto con voz ronca"
      punishment="Dos ejércitos empujan enormes pesos con el pecho, en semicírculos opuestos. Al chocar se gritan «¿Por qué guardas?» y «¿Por qué derrochas?», dan media vuelta y empiezan otra vez."
      guardian="Pluto, el dios de la riqueza, hinchado de rabia."
    />

    <Scene
      id="ira" mode="bubbles" bg="#090a09" glow="#1d1f1a" level={5} label="V · Ira" num="V" layout="wide"
      kicker="Círculo V · Cantos VII–VIII" title="Ira y Pereza" sin="La laguna Estigia"
      plate={{ img: 'ira', alt: 'Virgilio muestra a Dante las almas de los iracundos en la Estigia, grabado de Doré', caption: 'Figliuol, or vedi l\'anime di color cui vinse l\'ira', cite: 'Inferno VII, 115–116', fx: ['fog'] }}
      verse={['Fitti nel limo dicon: «Tristi fummo', "ne l'aere dolce che dal sol s'allegra»"]} cite="Inferno VII, 121–122"
      translation="Hundidos en el limo dicen: «Tristes fuimos en el aire dulce que el sol alegra»"
      punishment="Los iracundos se golpean, se muerden y se despedazan en el pantano. Bajo el agua, los perezosos borbotean su himno y hacen hervir la superficie."
      guardian="Flegias, el barquero, que los cruza veloz hacia las murallas rojas de Dis."
      figures={['Filippo Argenti']}
      insets={[{ img: 'estigia', alt: 'Flegias cruza la Estigia con Dante y Virgilio', caption: 'Flegïàs, Flegïàs, tu gridi a vòto', cite: 'Inferno VIII, 19' }]}
    />

    <Scene
      id="herejia" mode="embers" bg="#0c0907" glow="#2c2016" level={6} label="VI · Herejía" num="VI" layout="left"
      kicker="Círculo VI · Cantos IX–XI" title="La Ciudad de Dis" sin="Herejes y epicúreos"
      plate={{ img: 'farinata', alt: 'Farinata se alza desde su sepulcro ardiente, grabado de Doré', caption: "Ed el s'ergea col petto e con la fronte", cite: 'Inferno X, 35', fx: ['fire'], anim: 'flicker' }}
      verse={["Ed el s'ergea col petto e con la fronte", "com' avesse l'inferno a gran dispitto"]} cite="Inferno X, 35–36"
      translation="Y él se erguía con el pecho y con la frente, como si tuviese al infierno en gran desprecio"
      punishment="Yacen en sepulcros abiertos que arden al rojo vivo. El día del Juicio, las losas se cerrarán sobre ellos para siempre."
      guardian="Ángeles caídos cierran las puertas; desde las torres, las tres Furias llaman a Medusa. Sólo un mensajero del Cielo abre la ciudad con una varita."
      insets={[{ img: 'furias', alt: 'Las tres Furias en lo alto de la torre de Dis', caption: 'Quest\' è Megera dal sinistro canto', cite: 'Inferno IX, 46', tall: true }]}
      figures={['Farinata degli Uberti', 'Cavalcante', 'Federico II', 'Epicuro']}
    />

    <Scene
      id="violencia" mode="blood" bg="#0b0807" glow="#2a1d18" level={7} label="VII · Violencia" num="VII" layout="wide"
      kicker="Círculo VII · Anillo I · Canto XII" title="Violencia" sin="Contra el prójimo: tiranos, asesinos y saqueadores"
      plate={{ img: 'centauros', alt: 'Los centauros vigilan el río de sangre, grabado de Doré', caption: 'Corrien centauri, armati di saette', cite: 'Inferno XII, 56' }}
      verse={["Ma ficca li occhi a valle, ché s'approccia", 'la riviera del sangue']} cite="Inferno XII, 46–47"
      translation="Pero fija los ojos abajo, que se acerca el río de sangre"
      punishment="Hervidos en el Flegetonte, un río de sangre hirviente. Cuanto más grave el crimen, más hondo se hunden. Si alguno emerge más de lo debido, los centauros lo atraviesan con flechas."
      guardian="El Minotauro, «l'infamia di Creti», y los centauros Quirón, Neso y Folo."
      insets={[{ img: 'minotauro', alt: 'El Minotauro sobre el risco', caption: "l'infamia di Creti era distesa", cite: 'Inferno XII, 12', tall: true }]}
      figures={['Alejandro', 'Atila, «flagelo de la tierra»', 'Ezzelino da Romano']}
    />

    <Scene
      id="suicidas" mode="leaves" bg="#0a0908" glow="#1f1b16" level={7} label="VII · Violencia" layout="right"
      kicker="Círculo VII · Anillo II · Canto XIII" title="El Bosque de los Suicidas" sin="Contra sí mismos"
      plate={{ img: 'suicidas', alt: 'Las Harpías en el bosque de los suicidas, grabado de Doré', caption: 'Quivi le brutte Arpie lor nidi fanno', cite: 'Inferno XIII, 10', fx: ['fog'] }}
      verse={['«Perché mi schiante?', 'non hai tu spirto di pietade alcuno?»']} cite="Inferno XIII, 33–36"
      translation="¿Por qué me quiebras? ¿No tienes espíritu de piedad alguno?"
      punishment="Quienes rechazaron su cuerpo se vuelven árboles nudosos y espinosos. Las Harpías devoran sus hojas, y sólo al romperse una rama pueden hablar, sangrando. Los derrochadores huyen entre ellos, despedazados por perras negras."
      guardian="Las Harpías, aves con rostro humano."
      figures={['Pier delle Vigne', 'Lano da Siena', "Giacomo da Sant'Andrea"]}
    />

    <Scene
      id="sabbione" mode="firerain" bg="#0d0a07" glow="#33261a" level={7} label="VII · Violencia" layout="wide"
      kicker="Círculo VII · Anillo III · Cantos XIV–XVII" title="El Arenal Ardiente" sin="Contra Dios, la naturaleza y el arte"
      plate={{ img: 'fuego', alt: 'Los violentos bajo la lluvia de fuego, grabado de Doré', caption: 'piovean di foco dilatate falde', cite: 'Inferno XIV, 29', fx: ['fire'], anim: 'flicker' }}
      verse={["Sovra tutto 'l sabbion, d'un cader lento,", 'piovean di foco dilatate falde']} cite="Inferno XIV, 28–29"
      translation="Sobre todo el arenal, con un caer lento, llovían de fuego anchos copos"
      punishment="Un desierto de arena abrasadora bajo una lluvia eterna de fuego, como nieve en los Alpes sin viento. Los blasfemos yacen boca arriba, los sodomitas corren sin parar y los usureros se acurrucan con bolsas al cuello."
      figures={['Capaneo, que aún desafía a Júpiter', 'Brunetto Latini, maestro de Dante']}
    />

    <!-- Canto XVII: down on Geryon's back -->
    <Pin
      id="gerion" mode="embers" bg="#090807" glow="#1d1914" level={7} label="Gerión" len="360%" kicker="Canto XVII · El descenso" title="Gerión" sin="«sozza imagine di froda»" fx={['fog']}
      steps={[
        { img: 'gerion', x: 0.5, y: 0.12, s: 1.3 },
        { img: 'gerion', x: 0.6, y: 0.3, s: 1.9, it: 'Ecco la fiera con la coda aguzza,<br/>che passa i monti e rompe i muri e l\'armi', tr: 'He aquí la fiera de cola aguzada, que cruza montes y rompe muros y armas.', cite: 'Inferno XVII, 1–2' },
        { img: 'gerion', x: 0.5, y: 0.8, s: 1.3, it: 'Ella sen va notando lenta lenta;<br/>rota e discende', tr: 'Ella se va nadando lenta, lenta; gira y desciende.', cite: 'Inferno XVII, 115–116' },
      ]}
    />

    <Scene
      id="malebolge" mode="embers" bg="#0b0908" glow="#2a2018" level={8} label="VIII · Fraude" num="VIII" layout="wide"
      kicker="Círculo VIII · Cantos XVIII–XXX" title="Malebolge" sin="Fraude: diez fosos de piedra, puentes y castigos"
      plate={{ img: 'demonios', alt: 'Los Malebranche amenazan a Virgilio, grabado de Doré', caption: 'Nessun di voi sia fello!', cite: 'Inferno XXI, 72', fx: ['fire'] }}
      verse={["Luogo è in inferno detto Malebolge,", 'tutto di pietra di color ferrigno']} cite="Inferno XVIII, 1–2"
      translation="Hay un lugar en el infierno llamado Malebolge, todo de piedra de color ferroso"
      punishment="Diez fosas concéntricas, como fosos alrededor de un castillo, cruzadas por puentes de roca que descienden hacia el pozo central. Cada una alberga un tipo de engaño."
      guardian="Los Malebranche, demonios de garfios afilados."
    >
    </Scene>
    <section class="scene" id="bolge" data-scene data-mode="ash" data-bg="#0b0908" data-glow="#2a2018" data-level="8" data-label="VIII · Fraude" style="padding-top:0">
      <Bolge />
    </section>

    <!-- Canto XXXI -->
    <Pin
      id="gigantes" mode="ash" bg="#08090a" glow="#1a1d20" level={9} label="Los Gigantes" len="340%" kicker="Canto XXXI · El pozo" title="Los Gigantes" fx={['fog']}
      steps={[
        { img: 'titanes', x: 0.5, y: 0.5, s: 1.0 },
        { img: 'titanes', x: 0.62, y: 0.28, s: 2.1, it: '«Raphèl maì amècche zabì almi»,<br/>cominciò a gridar la fiera bocca', tr: 'Nemrod, culpable de Babel, sólo balbucea una lengua que nadie entiende.', cite: 'Inferno XXXI, 67–68' },
        { img: 'anteo', x: 0.56, y: 0.62, s: 1.35, it: 'Ma lievemente al fondo che divora<br/>Lucifero con Giuda, ci sposò', tr: 'Pero suavemente, al fondo que devora a Lucifer con Judas, nos depositó.', cite: 'Inferno XXXI, 142–143' },
      ]}
    />

    <Scene
      id="cocito" mode="snow" bg="#08090b" glow="#1c2128" level={9} label="IX · Traición" num="IX" layout="wide"
      kicker="Círculo IX · Cantos XXXII–XXXIII" title="Cocito" sin="La traición: el lago helado"
      plate={{ img: 'cocito', alt: 'Los traidores atrapados en el hielo del Cocito, grabado de Doré', caption: 'un lago che per gelo avea di vetro e non d\'acqua sembiante', cite: 'Inferno XXXII, 23–24', fx: ['cold'] }}
      verse={['e vidimi davante', 'e sotto i piedi un lago che per gelo', "avea di vetro e non d'acqua sembiante"]} cite="Inferno XXXII, 22–24"
      translation="y vi delante y bajo mis pies un lago que, por el hielo, parecía de vidrio y no de agua"
      punishment="No fuego, sino hielo: el pecado más frío. Caína, para traidores a la familia; Antenora, a la patria; Tolomea, a los huéspedes, con las lágrimas congeladas en los ojos; y Giudecca, a los señores, sepultados por completo, como paja en vidrio."
      insets={[{ img: 'ugolino', alt: 'El conde Ugolino royendo el cráneo del arzobispo Ruggieri', caption: "Poscia, più che 'l dolor, poté 'l digiuno", cite: 'Inferno XXXIII, 75' }]}
      figures={['Conde Ugolino', 'Arzobispo Ruggieri', 'Fray Alberigo', 'Mordred']}
    />

    <!-- Canto XXXIV -->
    <Pin
      id="lucifer" mode="icewind" bg="#060708" glow="#161a20" level={10} label="Lucifer" len="340%" kicker="Canto XXXIV · El fondo del universo" title="Lucifer" fx={['cold']}
      steps={[
        { img: 'lucifer', x: 0.5, y: 0.5, s: 1.0 },
        { img: 'lucifer', x: 0.5, y: 0.45, s: 1.5, it: 'Lo \'mperador del doloroso regno<br/>da mezzo \'l petto uscia fuor de la ghiaccia', tr: 'El emperador del doloroso reino emergía del hielo desde la mitad del pecho.', cite: 'Inferno XXXIV, 28–29' },
        { img: 'lucifer', x: 0.47, y: 0.47, s: 2.5, it: 'Con sei occhi piangëva, e per tre menti<br/>gocciava \'l pianto e sanguinosa bava', tr: 'Con seis ojos lloraba, y por tres barbillas goteaban el llanto y una baba sangrienta.', cite: 'Inferno XXXIV, 53–54' },
      ]}
    />

    <Pin
      id="centro" mode="ash" bg="#070605" glow="#1a1612" level={10} label="Centro de la Tierra" len="260%"
      steps={[
        { img: 'lucifer', x: 0.5, y: 0.6, s: 1.6, r: 0, it: 'Trepando por el pelaje de Lucifer, cruzan el centro de la Tierra…', cite: 'Inferno XXXIV, 70–75' },
        { img: 'lucifer', x: 0.5, y: 0.5, s: 1.3, r: 180, it: '«\'l punto<br/>al qual si traggon d\'ogne parte i pesi»', tr: 'El punto hacia el que tienden todos los pesos. La gravedad se invierte: lo que era bajar, ahora es subir.', cite: 'Inferno XXXIV, 110–111' },
      ]}
    />

    <section class="finale" id="salida" data-scene data-mode="stars" data-bg="#04050a" data-glow="#141a2c" data-level="11" data-label="Las estrellas">
      <div class="finale-sticky">
        <Plate img="estrellas" alt="Dante y Virgilio salen del Infierno y vuelven a ver las estrellas, grabado de Doré" kb={false} fx={['rays']} />
        <div class="finale-verse">
          <p class="kicker">Canto XXXIV · 139</p>
          <p class="big split">E quindi uscimmo a riveder le stelle.</p>
          <p class="tr">Y salimos de allí a volver a ver las estrellas.</p>
        </div>
      </div>
    </section>
    <footer class="colophon">
        <p>Fin del <b>INFERNO</b> · El viaje continúa en el <i>Purgatorio</i></p>
        <a href="#selva" class="btn" data-top>↑ Volver a la selva oscura</a>
