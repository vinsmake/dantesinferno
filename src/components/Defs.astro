---
// Shared SVG symbols / gradients / filters referenced via <use href="#..."> across the page.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="g-flame" cx="0.5" cy="0.78" r="0.75">
      <stop offset="0" stop-color="#fff7cf" />
      <stop offset="0.28" stop-color="#ffd05a" />
      <stop offset="0.6" stop-color="#ff5a12" />
      <stop offset="1" stop-color="#7a0700" stop-opacity="0.2" />
    </radialGradient>
    <radialGradient id="g-hot" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffb347" stop-opacity="0.9" />
      <stop offset="0.5" stop-color="#ff3d00" stop-opacity="0.35" />
      <stop offset="1" stop-color="#ff3d00" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="g-eye" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff2b0" />
      <stop offset="0.4" stop-color="#ff5a12" />
      <stop offset="1" stop-color="#ff2a00" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="g-cold" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#e8f7ff" stop-opacity="0.9" />
      <stop offset="0.5" stop-color="#7cc4ff" stop-opacity="0.3" />
      <stop offset="1" stop-color="#7cc4ff" stop-opacity="0" />
    </radialGradient>
    <filter id="f-glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
    <filter id="f-blur" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="10" />
    </filter>
    <filter id="f-rough" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" seed="3" />
      <feDisplacementMap in="SourceGraphic" scale="8" />
    </filter>

    <symbol id="soul" viewBox="0 0 20 50" overflow="visible">
      <circle cx="10" cy="7" r="5.2" />
      <path d="M10 12.5C3.5 14 3 24 4 33L6 50h8l2-17c1-9 .5-19-6-20.5Z" />
    </symbol>
    <symbol id="soul-arms" viewBox="0 0 30 50" overflow="visible">
      <circle cx="15" cy="7" r="5.2" />
      <path d="M15 12.5C8.5 14 8 24 9 33l2 17h8l2-17c1-9 .5-19-6-20.5Z" /><path d="M10 18 2 2 0 3l7 19Zm10 0 8-16 2 1-7 19Z" />
    </symbol>
    <symbol id="soul-run" viewBox="0 0 30 50" overflow="visible">
      <circle cx="18" cy="7" r="5" />
      <path d="M17 12c-5 1-7 6-8 12l-8 2 1 3 9-1 1 7-8 13 3 2 9-12 4 13h3l-3-17 1-8 7 5 2-2-8-9c0-6-1-9-5-9Z" />
    </symbol>
    <symbol id="flame" viewBox="0 0 20 40" overflow="visible">
      <path d="M10 0C12 9 20 14 20 25c0 8-4.5 15-10 15S0 33 0 25C0 17 6 14 7 6c2 4 3 7 3 10 1-5 1-10 0-16Z" fill="url(#g-flame)" />
    </symbol>
    <symbol id="head" viewBox="0 0 20 20" overflow="visible">
      <ellipse cx="10" cy="11" rx="6" ry="7" />
    </symbol>
  </defs>
</svg>
