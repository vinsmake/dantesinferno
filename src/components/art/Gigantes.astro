---
const giant = 'M-60 -200C-60 -250 60 -250 60 -200 62 -170 50 -140 30 -130L40 -110C110 -100 170 -80 190 -20L210 120 170 130 150 10 140 260H-140L-150 10-170 130-210 120-190-20C-170-80-110-100-40-110L-30-130C-50-140-62-170-60-200Z';
const giants = [
  { cls: 'g1', x: 380, s: 1.05, name: 'Efialtes', chain: true },
  { cls: 'g2', x: 800, s: 1.3, name: 'Nemrod', horn: true },
  { cls: 'g3', x: 1220, s: 1.1, name: 'Anteo' },
];
---
<section class="pin giants" id="gigantes" data-scene data-pin="giants" data-mode="ash" data-bg="#07080a" data-glow="#161c26" data-level="8" data-label="Los Gigantes">
  <div class="pin-title">
    <p class="kicker">Canto XXXI · El pozo</p>
    <h2 class="title">Los Gigantes</h2>
    <p class="sin">Como torres de Monteriggioni rodean el pozo central</p>
  </div>
  <div class="pin-stage">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="gi-fog" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#0a0c10" />
          <stop offset="1" stop-color="#2a3038" />
        </linearGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#gi-fog)" />
      {giants.map((g) => (
        <g class={`gi ${g.cls}`}>
          <g transform={`translate(${g.x} 560) scale(${g.s})`}>
            <path d={giant} fill="#0b0c0f" />
            <g class="pulse"><ellipse cx="-20" cy="-198" rx="7" ry="4" fill="#9fd8ff" opacity="0.8" /><ellipse cx="20" cy="-198" rx="7" ry="4" fill="#9fd8ff" opacity="0.8" /></g>
            {g.chain && <path d="M-190 -10C-80 40 80 40 190 -10M-180 50C-60 100 60 100 180 50" stroke="#3a3f48" stroke-width="10" stroke-dasharray="16 6" fill="none" />}
            {g.horn && <path d="M-30 -120C-60 -60 -40 0 30 20L60 10 40 -4C0 -20 -20 -60 -10 -120Z" fill="#4a3a28" />}
            <text y="-280" text-anchor="middle" font-family="Cinzel" font-size="24" letter-spacing="6" fill="#9fb3c8">{g.name.toUpperCase()}</text>
          </g>
        </g>
      ))}
      <!-- the rim of the well -->
      <path d="M0 640C300 600 600 620 800 610S1300 600 1600 640V900H0Z" fill="#050506" />
      <path d="M0 640C300 600 600 620 800 610S1300 600 1600 640" stroke="#3a4250" stroke-width="3" fill="none" />
      <ellipse cx="800" cy="720" rx="900" ry="80" fill="#aab4c4" opacity="0.08" filter="url(#f-blur)" class="gi-mist" />
      <g class="gi-shout" opacity="0">
        <text x="800" y="200" text-anchor="middle" font-family="IM Fell English" font-style="italic" font-size="54" fill="#cfe2ff">«Raphèl maì amècche zabì almi»</text>
      </g>
    </svg>
  </div>
  <div class="pin-caption">
    <p class="it">«Raphèl maì amècche zabì almi»,<br />cominciò a gridar la fiera bocca</p>
    <p class="tr">Nemrod, culpable de Babel, sólo balbucea un lenguaje que nadie entiende. Anteo, el único libre, nos deposita en el fondo.</p>
    <cite>Inferno XXXI, 67–68</cite>
  </div>
</section>
<style>
  .gi-mist { animation: fog-slide 12s ease-in-out infinite alternate; }
  @keyframes fog-slide { to { transform: translateX(-140px); } }
</style>
