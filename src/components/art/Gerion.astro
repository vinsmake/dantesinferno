---
import { range } from '../../lib/rng';
const rings = range(14).map((i) => ({ y: i * 130, o: 0.12 + (i % 3) * 0.05 }));
---
<section class="pin gerion" id="gerion" data-scene data-pin="geryon" data-mode="embers" data-bg="#0a0506" data-glow="#2a0a08" data-level="7" data-label="Gerión">
  <div class="pin-title">
    <p class="kicker">Canto XVII · El descenso</p>
    <h2 class="title">Gerión</h2>
    <p class="sin">«sozza imagine di froda» — inmunda imagen del fraude</p>
  </div>
  <div class="pin-stage">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="ger-abyss" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#000" />
          <stop offset="0.25" stop-color="#170807" />
          <stop offset="0.75" stop-color="#170807" />
          <stop offset="1" stop-color="#000" />
        </linearGradient>
        <linearGradient id="ger-fall" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#d4180c" />
          <stop offset="1" stop-color="#3a0402" />
        </linearGradient>
        <pattern id="ger-skin" width="28" height="28" patternUnits="userSpaceOnUse">
          <rect width="28" height="28" fill="#3b2015" />
          <circle cx="14" cy="14" r="8" fill="none" stroke="#c9a24a" stroke-width="2.5" />
          <circle cx="14" cy="14" r="3" fill="#8a1a10" />
          <path d="M0 0L6 6M28 0L22 6M0 28L6 22M28 28L22 22" stroke="#d26a2a" stroke-width="2" />
        </pattern>
      </defs>
      <rect width="1600" height="900" fill="url(#ger-abyss)" />
      <g class="ger-rings">
        {rings.map((r) => (
          <ellipse cx="800" cy={r.y} rx="900" ry="120" fill="none" stroke="#ff6a1a" stroke-opacity={r.o} stroke-width="2" />
        ))}
      </g>
      <!-- the roaring waterfall of Phlegethon -->
      <rect x="1360" y="0" width="70" height="900" fill="url(#ger-fall)" opacity="0.8" />
      <path d="M1370 0V900M1390 0V900M1410 0V900" stroke="#ff8a6a" stroke-width="2" stroke-dasharray="30 50" class="ger-water" opacity="0.6" />
      <!-- Geryon -->
      <g class="ger-beast">
        <g class="ger-flip">
          <g class="ger-tail">
            <path d="M-40 10C-120 40 -170 -30 -250 0S-360 60 -400 10" stroke="url(#ger-skin)" stroke-width="30" fill="none" stroke-linecap="round" />
            <path d="M-400 10L-450 -20M-400 10L-450 30" stroke="#c9a24a" stroke-width="7" stroke-linecap="round" />
          </g>
          <path d="M-60 0C-40 -50 120 -60 190 -20C200 20 140 50 60 45C0 44 -70 40 -60 0Z" fill="url(#ger-skin)" stroke="#120806" stroke-width="3" />
          <!-- hairy paws -->
          <g class="ger-paw"><path d="M110 30L150 90L170 92M150 90L160 104" stroke="#2a1810" stroke-width="12" stroke-linecap="round" fill="none" /></g>
          <g class="ger-paw two"><path d="M40 36L60 100L82 104M60 100L64 116" stroke="#2a1810" stroke-width="12" stroke-linecap="round" fill="none" /></g>
          <!-- the face of a just man -->
          <circle cx="215" cy="-30" r="30" fill="#b89474" />
          <path d="M188 -40C190 -70 240 -72 244 -42C236 -52 200 -56 188 -40Z" fill="#3a2614" />
          <path d="M196 -12C205 10 228 10 236 -12C226 -4 206 -4 196 -12Z" fill="#6a4a2c" />
          <circle cx="206" cy="-32" r="2.5" fill="#1a0e08" />
          <circle cx="226" cy="-32" r="2.5" fill="#1a0e08" />
          <!-- Dante & Virgil riding -->
          <use href="#soul" x="50" y="-104" width="22" height="55" fill="#e6d9c2" />
          <use href="#soul" x="86" y="-110" width="24" height="60" fill="#c9bfa8" />
        </g>
      </g>
    </svg>
  </div>
  <div class="pin-caption">
    <p class="it">«Ecco la fiera con la coda aguzza,<br />che passa i monti e rompe i muri e l'armi»</p>
    <p class="tr">He aquí la fiera de cola aguzada, que cruza los montes y rompe muros y armas.</p>
    <cite>Inferno XVII, 1–2</cite>
  </div>
</section>
<style>
  .ger-water { animation: ger-pour 0.6s linear infinite; }
  @keyframes ger-pour { to { stroke-dashoffset: -80; } }
  .ger-tail { transform-origin: -40px 10px; animation: ger-swish 2.4s ease-in-out infinite alternate; }
  @keyframes ger-swish { from { transform: rotate(-8deg); } to { transform: rotate(10deg); } }
  .ger-paw { transform-box: fill-box; transform-origin: 0 0; animation: ger-swim 1.6s ease-in-out infinite alternate; }
  .ger-paw.two { animation-delay: -0.8s; }
  @keyframes ger-swim { from { transform: rotate(-18deg); } to { transform: rotate(18deg); } }
</style>
