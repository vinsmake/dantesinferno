---
const lanes = [
  { y: 250, s: 0.55, d: -2.2, o: 0.5 },
  { y: 340, s: 0.75, d: -1.1, o: 0.75 },
  { y: 450, s: 1, d: 0, o: 1 },
];
---
<svg viewBox="0 0 1200 560" aria-hidden="true">
  <defs>
    <radialGradient id="av-rock" cx="0.35" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#d7b56a" />
      <stop offset="0.35" stop-color="#7a5c2c" />
      <stop offset="1" stop-color="#20160b" />
    </radialGradient>
    <linearGradient id="av-ground" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a2012" stop-opacity="0" />
      <stop offset="0.5" stop-color="#2a2012" />
      <stop offset="1" stop-color="#0d0904" />
    </linearGradient>
  </defs>
  <ellipse cx="600" cy="420" rx="640" ry="190" fill="url(#av-ground)" />
  <!-- Pluto -->
  <g transform="translate(600 120)" class="av-pluto">
    <path d="M-90 80C-110 10 -60 -40 0 -40C60 -40 110 10 90 80Z" fill="#160f08" />
    <circle cx="0" cy="-58" r="30" fill="#160f08" />
    <ellipse cx="0" cy="-44" rx="10" ry="7" fill="#3a0a02" />
    <circle cx="-11" cy="-64" r="3.5" fill="#ffb02e" class="pulse" />
    <circle cx="11" cy="-64" r="3.5" fill="#ffb02e" class="pulse" />
    <text y="-110" text-anchor="middle" font-family="IM Fell English" font-style="italic" font-size="26" fill="#ffcf7a" class="av-shout-p">«Pape Satàn, pape Satàn aleppe!»</text>
  </g>
  {lanes.map((l) => (
    <g transform={`translate(0 ${l.y})`} opacity={l.o}>
      <g transform={`translate(600 0) scale(${l.s}) translate(-600 0)`}>
        <g class="av-left" style={`animation-delay:${l.d}s`}>
          <use href="#soul-run" x="90" y="-62" width="38" height="62" fill="#8d7a5e" />
          <g transform="translate(200 -55)"><g class="av-roll-l" style={`animation-delay:${l.d}s`}>
            <circle r="56" fill="url(#av-rock)" />
            <path d="M-30 -20L0 5L25 -25M0 5L5 40" stroke="#2a1d0e" stroke-width="3" fill="none" />
          </g></g>
        </g>
        <g class="av-right" style={`animation-delay:${l.d}s`}>
          <g transform="translate(1110 0) scale(-1 1)"><use href="#soul-run" y="-62" width="38" height="62" fill="#8d7a5e" /></g>
          <g transform="translate(1000 -55)"><g class="av-roll-r" style={`animation-delay:${l.d}s`}>
            <circle r="56" fill="url(#av-rock)" />
            <path d="M-30 -20L0 5L25 -25M0 5L5 40" stroke="#2a1d0e" stroke-width="3" fill="none" />
          </g></g>
        </g>
        <g class="av-clash" style={`animation-delay:${l.d}s`}>
          <circle cx="600" cy="-55" r="70" fill="url(#g-hot)" />
          <text x="470" y="-140" text-anchor="middle" font-family="Cinzel" font-weight="800" font-size="30" fill="#ffcf7a">«¿PERCHÉ TIENI?»</text>
          <text x="730" y="-180" text-anchor="middle" font-family="Cinzel" font-weight="800" font-size="30" fill="#ffcf7a">«¿PERCHÉ BURLI?»</text>
        </g>
      </g>
    </g>
  ))}
</svg>
<style>
  .av-left { animation: av-l 5s cubic-bezier(0.5, 0, 0.9, 0.6) infinite; }
  .av-right { animation: av-r 5s cubic-bezier(0.5, 0, 0.9, 0.6) infinite; }
  @keyframes av-l { 0% { transform: translateX(0); } 48% { transform: translateX(344px); } 54% { transform: translateX(320px); } 100% { transform: translateX(0); } }
  @keyframes av-r { 0% { transform: translateX(0); } 48% { transform: translateX(-344px); } 54% { transform: translateX(-320px); } 100% { transform: translateX(0); } }
  .av-roll-l { animation: av-spin 5s cubic-bezier(0.5, 0, 0.9, 0.6) infinite; }
  .av-roll-r { animation: av-spin 5s cubic-bezier(0.5, 0, 0.9, 0.6) infinite reverse; }
  @keyframes av-spin { 0% { transform: rotate(0); } 48% { transform: rotate(350deg); } 100% { transform: rotate(0); } }
  .av-clash { opacity: 0; animation: av-boom 5s infinite; }
  @keyframes av-boom { 0%, 46% { opacity: 0; } 49% { opacity: 1; } 70% { opacity: 0.8; } 85%, 100% { opacity: 0; } }
  .av-shout-p { animation: av-shake 0.15s linear infinite; }
  @keyframes av-shake { 0% { transform: translate(0, 0); } 33% { transform: translate(1.5px, -1px); } 66% { transform: translate(-1px, 1.5px); } }
</style>
