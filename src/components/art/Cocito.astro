---
import { rng, r1, range } from '../../lib/rng';
const r = rng(123);
const cx = 600, cy = 330;
const zones = [
  { n: 'CAÍNA', rx: 560, ry: 230 },
  { n: 'ANTENORA', rx: 420, ry: 172 },
  { n: 'TOLOMEA', rx: 285, ry: 116 },
  { n: 'GIUDECCA', rx: 150, ry: 60 },
];
// frozen heads: only in the outer three zones
const heads = range(70).map(() => {
  const a = r() * Math.PI * 2;
  const k = 0.32 + r() * 0.62;
  return { x: r1(cx + Math.cos(a) * 560 * k), y: r1(cy + Math.sin(a) * 230 * k), s: r1(0.5 + k * 0.6), up: k < 0.5 };
});
const entombed = range(9).map(() => {
  const a = r() * Math.PI * 2;
  const k = r() * 0.8;
  return { x: r1(cx + Math.cos(a) * 140 * k), y: r1(cy + Math.sin(a) * 50 * k), rot: r1(r() * 360) };
});
const cracks = range(12).map(() => {
  let x = cx + (r() - 0.5) * 900;
  let y = cy + (r() - 0.5) * 300;
  let d = `M${r1(x)} ${r1(y)}`;
  for (let i = 0; i < 6; i++) {
    x += (r() - 0.5) * 120;
    y += (r() - 0.5) * 50;
    d += `L${r1(x)} ${r1(y)}`;
  }
  return d;
});
---
<svg viewBox="0 0 1200 620" class="cocito-svg" aria-hidden="true">
  <defs>
    <radialGradient id="co-ice" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#0b2034" />
      <stop offset="0.6" stop-color="#5a8bb0" />
      <stop offset="0.9" stop-color="#cfe8fa" />
      <stop offset="1" stop-color="#eaf6ff" />
    </radialGradient>
    <clipPath id="co-clip"><ellipse cx={cx} cy={cy} rx="580" ry="240" /></clipPath>
  </defs>
  <ellipse cx={cx} cy={cy + 12} rx="600" ry="250" fill="#0a1420" />
  <ellipse cx={cx} cy={cy} rx="580" ry="240" fill="url(#co-ice)" />
  {zones.map((z, i) => (
    <g>
      <ellipse cx={cx} cy={cy} rx={z.rx} ry={z.ry} fill="none" stroke="#eaf6ff" stroke-opacity="0.45" stroke-dasharray={i === 0 ? '0' : '4 6'} />
      <text x={cx} y={cy + z.ry - 8} text-anchor="middle" font-family="Cinzel" font-size="13" letter-spacing="5" fill="#eaf6ff" opacity="0.8">{z.n}</text>
    </g>
  ))}
  <g clip-path="url(#co-clip)" stroke="#ffffff" stroke-opacity="0.6" stroke-width="1.2" fill="none">
    {cracks.map((d, i) => <path d={d} class="co-crack" style={`animation-delay:${i * 0.25}s`} />)}
  </g>
  {entombed.map((e) => (
    <g transform={`translate(${e.x} ${e.y}) rotate(${e.rot}) scale(0.6)`} opacity="0.35">
      <use href="#soul" x="-10" y="-25" width="20" height="50" fill="#1a3a5a" />
    </g>
  ))}
  {heads.map((h) => (
    <g transform={`translate(${h.x} ${h.y}) scale(${h.s})`}>
      <ellipse cx="0" cy="4" rx="12" ry="4" fill="#0b2034" opacity="0.5" />
      <ellipse cx="0" cy="-4" rx="8" ry="10" fill={h.up ? '#4a6278' : '#2c3e50'} />
      <path d="M-6 -10Q0 -16 6 -10" stroke="#eaf6ff" stroke-width="2" fill="none" opacity="0.8" />
      {h.up && <circle cx="-3" cy="-5" r="1.3" fill="#eaf6ff" />}
      {h.up && <circle cx="3" cy="-5" r="1.3" fill="#eaf6ff" />}
    </g>
  ))}
  <!-- Ugolino gnawing Ruggieri -->
  <g transform="translate(810 410)">
    <circle r="34" fill="#c42a2a" opacity="0.18" class="pulse" />
    <ellipse cx="6" cy="-2" rx="11" ry="13" fill="#3a4a5a" />
    <g class="co-gnaw"><ellipse cx="-10" cy="-10" rx="11" ry="13" fill="#2a3a4a" /></g>
    <circle cx="-2" cy="-6" r="2" fill="#a01a10" />
    <text y="40" text-anchor="middle" font-family="Cinzel" font-size="12" fill="#ffcfcf" opacity="0.85">Ugolino</text>
  </g>
</svg>
<style>
  .co-crack { stroke-dasharray: 600; stroke-dashoffset: 600; animation: co-draw 6s ease-out infinite; }
  @keyframes co-draw { 0% { stroke-dashoffset: 600; } 40%, 85% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  .co-gnaw { animation: co-bite 0.9s ease-in-out infinite alternate; }
  @keyframes co-bite { to { transform: translate(3px, 3px); } }
</style>
